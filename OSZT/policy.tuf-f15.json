{
  "_comment": [
    "Policy for an ASUS TUF Gaming F15 with an RTX 3050.",
    "This is the cautious policy: the agent can read your whole home directory",
    "but may only change things inside ~/oszt-workspace. Once you trust it, widen",
    "write_roots to ~ and the protected_paths list is what keeps you safe.",
    "set_gpu_mode is deliberately absent: switching graphics mode ends the",
    "desktop session, so it stays a human action.",
    "installable_apps lists the exact Flatpak ids the agent may install or remove.",
    "Installs are --user: they land in ~/.local/share/flatpak and never touch the",
    "OS. System RPMs (dnf) stay a human action, and Flathub is the only remote.",
    "installable_apps lists the exact Flatpak ids the agent may install or remove.",
    "Installs are --user: they land in ~/.local/share/flatpak and never touch the",
    "OS. System RPMs (dnf) stay a human action, and Flathub is the only remote.",
    "Set dry_run to false only once you have watched a full session in dry run."
  ],
  "allowed_capabilities": [
    "open_app",
    "close_app",
    "list_installable_apps",
    "install_app",
    "uninstall_app",
    "list_files",
    "read_text",
    "find_files",
    "disk_usage",
    "write_text",
    "make_dir",
    "move_path",
    "copy_path",
    "delete_path",
    "restore_path",
    "list_trash",
    "list_cleaners",
    "clean_caches",
    "find_duplicates",
    "download_file",
    "capture_screen",
    "read_screenshot_base64",
    "set_volume",
    "set_brightness",
    "set_power_profile",
    "get_power_profile",
    "set_keyboard_backlight",
    "set_keyboard_colour",
    "set_charge_limit",
    "get_gpu_mode",
    "gpu_status",
    "sync_preferences_to_cloud",
    "fetch_preferences_from_cloud",
    "delete_cloud_history"
  ],
  "allowed_apps": {
    "firefox": ["flatpak", "run", "org.mozilla.firefox"],
    "discord": ["flatpak", "run", "com.discordapp.Discord"],
    "steam": ["flatpak", "run", "com.valvesoftware.Steam"],
    "heroic": ["flatpak", "run", "com.heroicgameslauncher.hgl"],
    "bottles": ["flatpak", "run", "com.usebottles.bottles"],
    "soundux": ["soundux"],
    "rog-control-center": ["rog-control-center"],
    "files": ["nautilus"],
    "terminal-readonly": ["gnome-system-monitor"]
  },
  "file_roots": ["~"],
  "write_roots": ["~/oszt-workspace"],
  "protected_paths": [
    "/usr",
    "/etc",
    "/boot",
    "/bin",
    "/sbin",
    "/lib",
    "/lib64",
    "/var",
    "/opt",
    "/proc",
    "/sys",
    "/dev",
    "/run",
    "/ostree",
    "/sysroot",
    "~/.ssh",
    "~/.gnupg",
    "~/.pki",
    "~/.local/share/keyrings",
    "~/.config/oszt",
    "~/.local/share/oszt"
  ],
  "trash_dir": "~/.local/share/oszt-trash",
  "installable_apps": [
    "org.mozilla.firefox",
    "com.discordapp.Discord",
    "com.valvesoftware.Steam",
    "com.heroicgameslauncher.hgl",
    "com.usebottles.bottles",
    "org.videolan.VLC",
    "org.libreoffice.LibreOffice",
    "com.spotify.Client",
    "org.gimp.GIMP",
    "com.obsproject.Studio",
    "org.telegram.desktop",
    "md.obsidian.Obsidian"
  ],
  "allowed_cleaners": ["flatpak-unused", "journal", "dnf-cache", "thumbnails"],
  "allowed_hosts": ["flathub.org", "download.mozilla.org", "github.com", "objects.githubusercontent.com"],
  "max_download_bytes": 536870912,
  "max_calls_per_minute": 60,
  "dry_run": true
}
